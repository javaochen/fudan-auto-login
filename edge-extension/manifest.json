{
  "manifest_version": 3,
  "name": "复旦登录监测",
  "short_name": "复旦登录",
  "version": "0.3.1",
  "description": "定时检查复旦常用站点的统一认证登录态，失效时提醒并在后台补开认证页；不保存账号密码。",
  "homepage_url": "https://github.com/javaochen/fudan-auto-login",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://icourse.fudan.edu.cn/*",
    "https://id.fudan.edu.cn/*",
    "https://ehall.fudan.edu.cn/*",
    "https://elearning.fudan.edu.cn/*",
    "https://my.fudan.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "复旦登录状态",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
